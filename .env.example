GOOGLE_API_KEY=
# Optional: preferred head of the Gemini cascade (overrides models.yaml order).
# GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
SAMBANOVA_API_KEY=
DEEPSEEK_API_KEY=
HF_TOKEN=
HUGGINGFACE_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=
NVIDIA_NIM_API_KEY=
DEEPINFRA_API_KEY=

# Historical stats (optional). App loads .env automatically on API start.
# Quote the URI — unquoted `&` in query strings breaks bash `source` / deploy.sh.
# MONGODB_URI='mongodb+srv://USER:PASS@cluster.mongodb.net/llmrouter?retryWrites=true&w=majority'
# LLMROUTER_MONGO_DB=llmrouter

# --- Self-hosted security (optional; defaults are open / local-dev friendly) ---
# REQUIRE_AUTH=false
# Comma-separated keys required on POST /v1/complete when REQUIRE_AUTH=true
# LLMROUTER_API_KEYS=change-me,another-key
# Optional per-API-key requests-per-minute (only when REQUIRE_AUTH=true)
# LLMROUTER_API_RPM=60
# Used to sign admin JWTs and derive Fernet key material for UI-stored provider keys
# SECRET_KEY=
# Force Secure cookies (set true behind HTTPS / reverse proxy)
# LLMROUTER_COOKIE_SECURE=true
# Local store for admin credentials + encrypted provider keys
# LLMROUTER_DATA_DIR=.llmrouter
