# Routing: headroom (default) = most remaining RPD, stay on last success per notes.
# Opt-in: round_robin | least_used | priority_first | weighted
# LLMCASCADE_STRATEGY=headroom

# Historical stats (optional). App loads .env automatically on API start.
# Quote the URI — unquoted `&` in query strings breaks bash `source` / deploy.sh.
# MONGODB_URI='mongodb+srv://USER:PASS@cluster.mongodb.net/llmcascade?retryWrites=true&w=majority'
# LLMCASCADE_MONGO_DB=llmcascade

# --- Self-hosted security ---
# Local/dev defaults stay open. For any non-localhost exposure use production profile
# or set REQUIRE_AUTH=true with strong credentials.
# LLMCASCADE_PROFILE=production
# REQUIRE_AUTH=false
# Prefer bcrypt hashes (quote values — shells expand $). Generate with:
#   python -c "from llmcascade.api_auth import hash_api_key; print(hash_api_key('change-me'))"
# LLMCASCADE_API_KEY_HASHES='$2b$12$...'
# Plaintext still accepted for migration (comma-separated); mix hashes in LLMCASCADE_API_KEYS too
# LLMCASCADE_API_KEYS=change-me,another-key
# Optional per-API-key requests-per-minute (only when auth is on)
# LLMCASCADE_API_RPM=60
# Separate Bearer keys for MCP admin tools (never reuse inference keys; prefer hashes)
# python -c "from llmcascade.api_auth import hash_api_key; print(hash_api_key('change-me-admin'))"
# LLMCASCADE_ADMIN_API_KEY_HASHES='$2b$12$...'
# LLMCASCADE_ADMIN_API_KEYS=change-me-admin
# Allow models with key_tier=paid in auto-select (default off — spend gate)
# ALLOW_PAID=false
# Used to sign admin JWTs and derive Fernet key material for UI-stored provider keys
# SECRET_KEY=
# Force Secure cookies (set true behind HTTPS / reverse proxy)
# LLMCASCADE_COOKIE_SECURE=true
# Local store for admin credentials + encrypted provider keys
# LLMCASCADE_DATA_DIR=.llmcascade

# --- Retired-model watcher (separate process: python -m llmcascade.retire_watch) ---
# LLMCASCADE_BASE_URL=http://127.0.0.1:12000
# RETIRE_WATCH_INTERVAL_S=120
# Plaintext inference/admin keys for the watcher when hashes-only is set on the API:
# LLMCASCADE_RETIRE_API_KEY=
# LLMCASCADE_RETIRE_ADMIN_KEY=
# ADMIN_EMAIL=ops@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=true
